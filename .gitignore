.scratch/wencai-import-prototype/profile/
.scratch/wencai-import-prototype/evidence/
.scratch/wencai-import-prototype/url.txt

# Python 环境与缓存
.venv/
.venv-api/
.venv-web/
__pycache__/
*.py[cod]
*.egg-info/

# 前端构建与测试产物
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.shots/
*.tsbuildinfo

# 工单 02 实源验证原始证据（含脱敏摘要，不提交）
.scratch/lite-research-workbench/evidence/

# pnpm 本地包缓存（依赖版本以 frontend/pnpm-lock.yaml 为准）
.pnpm-store/

# 本地工作日志、一次性脚本与旧代码快照；正式证据保留在各专题 evidence/
.scratch/_local/

# 本机跑 pytest --junit-xml 的临时输出；正式验收日志另存各专题 evidence/
tmp-*.xml
